# ============================================
# Eduzyra AI Assistant — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file with secrets to Git!
# ============================================

# ---- LLM Configuration ----
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# The model to use for chat responses
# Options: llama-3.3-70b-versatile, qwen/qwen3.8-27b, llama-3.1-8b-instant, mixtral-8x7b-32768
LLM_MODEL_NAME=llama-3.3-70b-versatile

# Maximum tokens the LLM can generate per response
LLM_MAX_TOKENS=1024

# Temperature controls randomness (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# ---- Embedding Configuration ----
# The embedding model (used in both local and cloud mode)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Hugging Face API token (free at https://huggingface.co/settings/tokens)
# Required ONLY when USE_CLOUD_EMBEDDINGS=true
HUGGINGFACE_API_KEY=

# Set to true for production deployment (Render, Railway, etc.)
# Uses HF Inference API instead of local PyTorch — saves ~2.5 GB disk space
# Set to false (or omit) for local development with sentence-transformers
USE_CLOUD_EMBEDDINGS=false

# ---- Vector Store Configuration ----
# Path to store the FAISS index files
VECTOR_STORE_PATH=data/vector_store

# Number of similar chunks to retrieve for each query
RETRIEVAL_TOP_K=4

# ---- Database Configuration ----
# SQLite Async URL
DATABASE_URL=sqlite+aiosqlite:///data/chatbot.db

# ---- Document Processing ----
# Maximum file size for uploads (in bytes, default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Chunk size for splitting documents (in characters)
CHUNK_SIZE=500

# Overlap between chunks (in characters)
CHUNK_OVERLAP=50

# Path to store uploaded files
UPLOAD_DIR=data/uploads

# ---- Application Settings ----
# Application name
APP_NAME=Eduzyra AI

# Debug mode (set to false in production!)
DEBUG=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Memory Settings ----
# Number of past messages to include as context
MEMORY_WINDOW_SIZE=10

# ---- 3-Way Intelligent Routing ----
# Similarity threshold for RAG vs Direct LLM routing (0.0 - 1.0)
RAG_SIMILARITY_THRESHOLD=0.35

# ---- Admin Settings ----
# API key for admin endpoints (document upload, deletion, index rebuild)
ADMIN_API_KEY=eduzyra-admin-secret-key-change-me

# ---- Logging ----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ---- Frontend Configuration (Vite) ----
VITE_API_URL=http://localhost:8000/api
