# ============================================
# AI Chatbot — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to Git!
# ============================================

# ---- LLM Configuration ----
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# The model to use for chat responses
# Options: llama-3.1-8b-instant, mixtral-8x7b-32768, llama-3.1-70b-versatile
LLM_MODEL_NAME=llama-3.1-8b-instant

# Maximum tokens the LLM can generate per response
LLM_MAX_TOKENS=1024

# Temperature controls randomness (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# ---- Embedding Configuration ----
# The embedding model (runs locally, no API key needed)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---- Vector Store Configuration ----
# Path to store the FAISS index files
VECTOR_STORE_PATH=data/vector_store

# Number of similar chunks to retrieve for each query
RETRIEVAL_TOP_K=4

# ---- Database Configuration ----
# SQLite (development) — just a file path
# For PostgreSQL (production), use: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///data/chatbot.db

# ---- Document Processing ----
# Maximum file size for uploads (in bytes, default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Chunk size for splitting documents (in characters)
CHUNK_SIZE=500

# Overlap between chunks (in characters)
CHUNK_OVERLAP=50

# Path to store uploaded files
UPLOAD_DIR=data/uploads

# ---- Application Settings ----
# Application name (shown in API docs)
APP_NAME=EduBot

# Debug mode (set to false in production!)
DEBUG=true

# CORS origins (comma-separated, e.g., http://localhost:5173,https://yourdomain.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Memory Settings ----
# Number of past messages to include as context
MEMORY_WINDOW_SIZE=10

# ---- Intelligent Routing ----
# Similarity threshold for RAG vs Direct LLM routing (0.0 - 1.0)
# Lower = use RAG more often; Higher = only use RAG with strong matches
RAG_SIMILARITY_THRESHOLD=0.35

# ---- Admin Settings ----
# API key for admin endpoints (document upload, deletion, index rebuild)
# Change this to a strong, unique value in production!
ADMIN_API_KEY=edubot-admin-key-change-me

# ---- Logging ----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
