# ============================================
# Eduzyra AI Backend — Environment Variables
# ============================================
# Copy this file to .env inside backend/
#   cp .env.example .env
# ============================================

# ---- LLM Configuration ----
GROQ_API_KEY=your_groq_api_key_here
# Options: llama-3.3-70b-versatile, qwen/qwen3.8-27b, llama-3.1-8b-instant
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ---- Embedding Configuration ----
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---- Vector Store Configuration ----
VECTOR_STORE_PATH=data/vector_store
RETRIEVAL_TOP_K=4

# ---- Database Configuration ----
DATABASE_URL=sqlite+aiosqlite:///data/chatbot.db

# ---- Document Processing ----
MAX_UPLOAD_SIZE=10485760
CHUNK_SIZE=500
CHUNK_OVERLAP=50
UPLOAD_DIR=data/uploads

# ---- Application Settings ----
APP_NAME=Eduzyra AI
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Memory Settings ----
MEMORY_WINDOW_SIZE=10

# ---- 3-Way Intelligent Routing ----
RAG_SIMILARITY_THRESHOLD=0.35

# ---- Admin Settings ----
ADMIN_API_KEY=eduzyra-admin-secret-key-change-me

# ---- Logging ----
LOG_LEVEL=INFO
